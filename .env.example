DOCUMENT_EXTRACTOR=mock
NUTRIENT_DWS_API_KEY=
NUTRIENT_DWS_BASE_URL=https://api.nutrient.io
AUTO_APPROVE_CONFIDENCE_THRESHOLD=0.85

# Demo throttling (optional). Leave both blank to disable rate limiting locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# One shared per-IP counter across triage, approve, speech, persona
# generation and upload. Reviewing one request costs three, so 30 is
# roughly ten full walkthroughs per window.
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=300

# AI-generated personas and voice narration (optional).
OPENAI_API_KEY=

# The agent pipeline. Every agent reasons through the Reasoning
# capability. Set to "mock" to force the deterministic rules even when
# an OpenAI key is present; with no key the mock is used automatically,
# so triage still runs end to end and still produces a full trace.
AGENT_REASONER=openai
OPENAI_REASONING_MODEL=gpt-4o-mini
REASONING_TIMEOUT_SECONDS=20
